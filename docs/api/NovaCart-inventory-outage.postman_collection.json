{
  "info": {
    "name": "NovaCart: inventory service outage",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requirement 2 proof: what the user sees when the inventory service is stopped or slow.\n\nRun the folders **in order**, one at a time, and do the step written in each folder's description in a terminal before running it.\n\nSet `baseUrl` (default http://localhost:8080/api/v1)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Service running: prepare a cart",
      "description": "The inventory service is running normally.",
      "item": [
        {
          "name": "Register a customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"outage{{runId}}\",\n  \"email\": \"outage-{{runId}}@example.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pick a product in stock",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().data.find(x => x.stock_quantity > 0);",
                  "pm.collectionVariables.set(\"productId\", p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add it to the cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "{{productId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Service stopped",
      "description": "In a terminal first run:\n\n    docker compose stop inventory\n\n(For a *slow* service instead: `INVENTORY_ARTIFICIAL_DELAY_MS=5000 docker compose up -d inventory` — every call then hits the 2 s deadline.)",
      "item": [
        {
          "name": "Browsing still works, stock unknown",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Reading degrades gracefully: products are shown, with stock_quantity null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Stock reported as unknown\", () => pm.expect(pm.response.json().data[0].stock_status).to.eql(\"unknown\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout → 503 with a clear message, no waiting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Every gRPC call has a 2-second deadline (INVENTORY_TIMEOUT_MS). No order is created and the cart is kept.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 503\", () => pm.response.to.have.status(503));",
                  "pm.test(\"Unified error format\", () => { const j = pm.response.json(); pm.expect(j).to.have.keys([\"status\",\"code\",\"message\"].concat(j.errors ? [\"errors\"] : [])); pm.expect(j.status).to.eql(pm.response.code); });",
                  "pm.test(\"Clear message\", () => pm.expect(pm.response.json().message).to.include(\"inventory service is not available\"));",
                  "pm.test(\"Retry-After header\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.eql(\"5\"));",
                  "pm.test(\"Answered within the deadline\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Service back",
      "description": "In a terminal first run:\n\n    docker compose start inventory\n\n(or `docker compose up -d inventory` after the slow-service variant). Wait until `docker compose ps` shows it healthy.",
      "item": [
        {
          "name": "Same checkout now succeeds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) pm.collectionVariables.set(\"runId\", Date.now());"
        ]
      }
    }
  ]
}
